---
/**
 * PluginIcon: the registry carries no icon files (they live inside the
 * packages), so a plugin is shown with a monogram on a hue derived from its
 * id: stable for a plugin, never taken from anywhere else.
 */
type Props = { id: string; name: string; size?: 'md' | 'lg' };
const { id, name, size = 'md' } = Astro.props;
const letters = name
  .split(/[\s._-]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => [...word][0]?.toUpperCase() ?? '')
  .join('');
let hash = 0;
for (const ch of id) hash = (hash * 31 + ch.charCodeAt(0)) % 360;
const hue = 190 + (hash % 80); // stays within the brand's blue range
---

<span
  class:list={['plugin-icon', size === 'lg' && 'is-lg']}
  style={`background: linear-gradient(145deg, hsl(${hue} 70% 22%), #07112f)`}
  aria-hidden="true">{letters}</span
>
