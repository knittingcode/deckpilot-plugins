---
import { ArrowRight, ShieldAlert } from '@lucide/astro';
import Button from '@/components/Button.astro';
import GitHubMark from '@/components/GitHubMark.astro';
import Notice from '@/components/Notice.astro';
import { LINKS } from '@/data/site';
import { langPaths, t, type Lang } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { page } from '@/lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const dict = t(lang);
const c = dict.community;

const sections = [
  { id: 'submit', title: c.submit.title },
  { id: 'review', title: c.review.title },
  { id: 'security-requirements', title: c.security.title },
  { id: 'licenses', title: c.licenses.title },
  { id: 'versioning', title: c.versioning.title },
  { id: 'revocation', title: c.revocation.title },
  { id: 'reporting', title: c.reporting.title },
  { id: 'conduct', title: c.conduct.title },
  { id: 'other', title: c.other.title },
];
---

<Base lang={lang} title={c.metaTitle} description={c.description}>
  <div class="container docs-layout has-toc !grid-cols-1 lg:!grid-cols-[minmax(0,1fr)_14rem]">
    <div class="min-w-0 max-w-[48rem]">
      <span class="eyebrow">{dict.home.community.eyebrow}</span>
      <h1 class="section-title">{c.title}</h1>
      <p class="section-lead">{c.lead}</p>
      <Notice class="mt-8">
        <strong>{c.statusTitle}.</strong>{' '}
        {c.status}
      </Notice>

      <section class="mt-14 scroll-mt-24" id="submit" aria-labelledby="submit-title">
        <h2 class="text-[length:var(--text-2xl)]" id="submit-title">{c.submit.title}</h2>
        <p class="mt-3 text-muted">{c.submit.lead}</p>
        <ol class="steps mt-6 !grid-cols-1 sm:!grid-cols-2">
          {
            c.submit.steps.map((step) => (
              <li class="card step">
                <h3 class="card-title">{step.title}</h3>
                <p class="card-text text-sm">{step.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-muted">{c.submit.namespace}</p>
        <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <a class="link-arrow" href={page(lang, 'docs/submission')}>{c.submit.guide}<ArrowRight aria-hidden="true" /></a>
          <a class="link-arrow" href={LINKS.contributing} rel="noopener">{c.submit.contributing}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="review" aria-labelledby="review-title">
        <h2 class="text-[length:var(--text-2xl)]" id="review-title">{c.review.title}</h2>
        <p class="mt-3 text-muted">{c.review.lead}</p>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            c.review.checks.map((check) => (
              <div class="card !p-5">
                <dt class="font-semibold text-fg">{check.title}</dt>
                <dd class="m-0 mt-1 text-sm text-muted">{check.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-5 text-muted">{c.review.publish}</p>
        <p class="mt-3 text-muted">{c.review.times}</p>
        <p class="mt-5">
          <a class="link-arrow" href={LINKS.reviewPolicy} rel="noopener">{c.review.policy}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="security-requirements" aria-labelledby="secreq-title">
        <h2 class="text-[length:var(--text-2xl)]" id="secreq-title">{c.security.title}</h2>
        <p class="mt-3 text-muted">{c.security.lead}</p>
        <ul class="mt-4 grid list-disc gap-2 pl-5 text-muted">
          {c.security.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-5">
          <a class="link-arrow" href={page(lang, 'docs/security')}>{c.security.guide}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="licenses" aria-labelledby="licenses-title">
        <h2 class="text-[length:var(--text-2xl)]" id="licenses-title">{c.licenses.title}</h2>
        <ul class="mt-4 grid list-disc gap-2 pl-5 text-muted">
          {c.licenses.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-4 text-sm text-subtle">{c.licenses.note}</p>
        <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <a class="link-arrow" href={LINKS.license} rel="noopener">{c.licenses.link}<ArrowRight aria-hidden="true" /></a>
          <a class="link-arrow" href={LINKS.contributing} rel="noopener">{c.submit.contributing}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="versioning" aria-labelledby="versioning-title">
        <h2 class="text-[length:var(--text-2xl)]" id="versioning-title">{c.versioning.title}</h2>
        <ul class="mt-4 grid list-disc gap-2 pl-5 text-muted">
          {c.versioning.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-5">
          <a class="link-arrow" href={LINKS.publishing} rel="noopener">{c.versioning.link}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="revocation" aria-labelledby="revocation-title">
        <h2 class="text-[length:var(--text-2xl)]" id="revocation-title">{c.revocation.title}</h2>
        <p class="mt-3 text-muted">{c.revocation.lead}</p>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="card !p-5">
            <dt class="font-semibold text-fg">{c.revocation.yankTitle}</dt>
            <dd class="m-0 mt-1 text-sm text-muted">{c.revocation.yank}</dd>
          </div>
          <div class="card !p-5">
            <dt class="font-semibold text-fg">{c.revocation.disableTitle}</dt>
            <dd class="m-0 mt-1 text-sm text-muted">{c.revocation.disable}</dd>
          </div>
        </dl>
        <p class="mt-5 text-muted">{c.revocation.cumulative}</p>
        <p class="mt-5">
          <a class="link-arrow" href={LINKS.trustModel} rel="noopener">{c.revocation.link}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="reporting" aria-labelledby="reporting-title">
        <h2 class="text-[length:var(--text-2xl)]" id="reporting-title">{c.reporting.title}</h2>
        <p class="mt-3 text-muted">{c.reporting.lead}</p>
        <Notice variant="warning" class="mt-5">{c.reporting.dont}</Notice>
        <p class="mt-5 text-muted">{c.reporting.scope}</p>
        <p class="mt-3 text-muted">{c.reporting.after}</p>
        <p class="mt-3 text-sm text-subtle">{c.reporting.caveat}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={LINKS.reportVulnerability} external><ShieldAlert aria-hidden="true" />{c.reporting.primary}</Button>
          <Button href={LINKS.security} variant="secondary" external>{c.reporting.policy}</Button>
          <Button href={LINKS.appSecurity} variant="ghost" external>{c.reporting.appPolicy}</Button>
        </div>
      </section>

      <section class="mt-14 scroll-mt-24" id="conduct" aria-labelledby="conduct-title">
        <h2 class="text-[length:var(--text-2xl)]" id="conduct-title">{c.conduct.title}</h2>
        <p class="mt-3 text-muted">{c.conduct.text}</p>
        <p class="mt-5">
          <a class="link-arrow" href={LINKS.codeOfConduct} rel="noopener">{c.conduct.link}<ArrowRight aria-hidden="true" /></a>
        </p>
      </section>

      <section class="mt-14 scroll-mt-24" id="other" aria-labelledby="other-title">
        <h2 class="text-[length:var(--text-2xl)]" id="other-title">{c.other.title}</h2>
        <p class="mt-3 text-muted">{c.other.text}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={LINKS.issues} variant="secondary" external><GitHubMark />{c.other.issues}</Button>
        </div>
      </section>
    </div>

    <nav class="docs-toc" aria-labelledby="community-toc">
      <p class="side-heading !pl-0" id="community-toc">{c.toc}</p>
      <ul class="toc-list">
        {sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>
