---
import PluginPage from '@/components/PluginPage.astro';
import RevokedPluginPage from '@/components/RevokedPluginPage.astro';
import { LANGS, type Lang } from '@/i18n';
import { getCatalog, type CatalogPlugin, type RevokedPlugin } from '@/lib/registry';

export function getStaticPaths() {
  const catalog = getCatalog();
  return LANGS.flatMap((lang) => [
    ...catalog.plugins.map((plugin) => ({ params: { lang, id: plugin.id }, props: { plugin } })),
    // A revoked plugin keeps its URL: the full page while the index still
    // lists it, otherwise a notice built from its signed revocations.
    ...catalog.revoked.map((revoked) => ({
      params: { lang, id: revoked.id },
      props: revoked.plugin ? { plugin: revoked.plugin } : { revoked },
    })),
  ]);
}

type Props = { plugin: CatalogPlugin; revoked?: undefined } | { plugin?: undefined; revoked: RevokedPlugin };
const { plugin, revoked } = Astro.props;
const lang = Astro.params.lang as Lang;
---

{plugin ? <PluginPage plugin={plugin} lang={lang} /> : <RevokedPluginPage revoked={revoked!} lang={lang} />}
