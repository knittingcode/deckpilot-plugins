# The DeckPilot commit whose registry tooling, schemas and plugin SDK this
# repository uses. Everything that verifies or signs the registry is built
# from exactly this commit (tools/build-cli.sh). Change it only in a reviewed
# pull request; validate.yml then checks schemas/ and rust-toolchain.toml
# against the new commit.
DECKPILOT_REPOSITORY=knittingcode/deckpilot
DECKPILOT_COMMIT=49d3f86776b917006dcb3d8814032252c6e6b272
