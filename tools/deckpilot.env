# The DeckPilot commit whose registry tooling, schemas and plugin SDK this
# repository uses. Everything that verifies or signs the registry is built
# from exactly this commit (tools/build-cli.sh). Change it only in a reviewed
# pull request; validate.yml then checks schemas/ and rust-toolchain.toml
# against the new commit.
DECKPILOT_REPOSITORY=knittingcode/deckpilot
# v0.10.0 (plugin API 1.9) plus the first-party publisher signature, its
# review fixes (release sign --id --version; knittingcode/deckpilot#377, #380,
# #379, #381, #382) and threshold-2 signatures, one file per key
# (<package>.<KEYID>.minisig; knittingcode/deckpilot#383), bundled plugins
# from verified release artifacts (#385) and the two production publisher
# keys pinned with threshold 2, plus the key test (#384); v0.11.0 release
# preparation (#386); the reviewed privileged policy (#387), its review
# fixes (#389) and the opening of the privileged-kinds gate for exactly that
# policy with the approved review (#388); the nine official plugins bundled
# from their signed releases (#391) with their sources removed and each
# locked release's files kept as its contract,
# plugins/first-party/contracts/deckpilot.<name>/ (#392); v0.12.0 release
# preparation (#393); the signed registry storefront: model, verification
# and `storefront check|build|sign`, `verify-site --require-storefront`
# (#399), and the agent side (#400).
DECKPILOT_COMMIT=d2745ac217815f7d120851e99d6e6a29661fa7bb
# The DeckPilot commit whose plugin SDK, ABI and first-party support crate
# official/ and first-party/ are built against: the `rev` of their
# Cargo.toml and Cargo.lock (tools/check-official.py, check-first-party.py).
# Cargo hashes a git dependency's revision into the build, so another rev
# rebuilds every module with other bytes: the official releases DeckPilot
# bundles (released-pins.json) were built at this one, and the released-pins
# guard of `tools/official.sh sign-test` refuses any other module under
# their versions. It moves only together with a new version of every
# official plugin, never with the tooling pin above. On DeckPilot's main
# and an ancestor of DECKPILOT_COMMIT (both checked by fetch_deckpilot).
DECKPILOT_SDK_COMMIT=8dc27d5a52d0fd9407644fc9562840f458063373
# The DeckPilot the official plugins (official/) are built and checked for:
# its version and plugin API at DECKPILOT_COMMIT (engines, release verify).
DECKPILOT_VERSION=0.12.0
DECKPILOT_PLUGIN_API=1.9
