{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/registry-storefront.schema.json",
  "title": "DeckPilot plugin registry: storefront/<seq>.json",
  "description": "Storefront design §3.3. Signed by the index role with the trusted comment 'deckpilot-registry v1 role:storefront seq:<seq> keys:<keys_version>'. Bound to the index the timestamp of the same seq pins; pins the listings and the editorial document by path, sha256 and length. At most 64 KiB. Older clients never fetch it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "spec_version",
    "storefront_version",
    "seq",
    "keys_version",
    "generated_at",
    "source_commit",
    "index",
    "listings"
  ],
  "properties": {
    "_type": {
      "const": "deckpilot-registry-storefront"
    },
    "spec_version": {
      "const": 1
    },
    "storefront_version": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "keys_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "length"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^index/[1-9][0-9]*\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ref"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 57,
            "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
          },
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "length"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^storefront/listings/[a-z0-9.-]+/[0-9a-f]{64}\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              }
            }
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "length"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^storefront/editorial/[0-9a-f]{64}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        }
      }
    }
  }
}
