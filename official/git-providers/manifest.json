{
  "$schema": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json",
  "manifestVersion": 1,
  "id": "deckpilot.git-providers",
  "name": "t:plugin.name",
  "version": "0.1.0",
  "publisher": {
    "id": "deckpilot",
    "name": "DeckPilot",
    "url": "https://github.com/knittingcode/deckpilot"
  },
  "description": "t:plugin.description",
  "repository": {
    "type": "git",
    "url": "https://github.com/knittingcode/deckpilot-plugins",
    "directory": "official/git-providers"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gitlab",
    "github",
    "merge-requests",
    "pipelines"
  ],
  "categories": [
    "developer-tools"
  ],
  "engines": {
    "deckpilot": ">=0.16.0 <1.0.0",
    "pluginApi": "^1.14",
    "sdk": "0.1.0"
  },
  "runtime": {
    "kind": "wasm",
    "abi": 1
  },
  "entry": "src/lib.rs",
  "icons": {
    "128": "assets/icon-128.png"
  },
  "defaultLocale": "en",
  "locales": [
    "en",
    "pl"
  ],
  "permissions": [
    {
      "kind": "connections",
      "types": [
        "github",
        "gitlab"
      ],
      "methods": [
        "GET",
        "POST",
        "PUT"
      ],
      "privateNetwork": true,
      "justification": "t:permissions.connections"
    },
    {
      "kind": "openUrl",
      "hosts": [],
      "connections": true,
      "justification": "t:permissions.openUrl"
    },
    {
      "kind": "dialogs",
      "justification": "t:permissions.dialogs"
    }
  ],
  "contributes": {
    "connectionTypes": [
      {
        "id": "github",
        "label": "t:types.github",
        "cloud": {
          "api": "https://api.github.com",
          "web": "https://github.com"
        },
        "selfHosted": {
          "apiPath": "/api/v3",
          "label": "t:types.ghes"
        },
        "auth": [
          {
            "method": "pat",
            "scheme": "bearer",
            "setupUrl": {
              "cloud": "https://github.com/settings/personal-access-tokens/new",
              "selfHosted": "{web}/settings/tokens/new"
            }
          }
        ],
        "extensions": [
          "github.checks",
          "github.review-requests",
          "github.workflow-dispatch"
        ]
      },
      {
        "id": "gitlab",
        "label": "t:types.gitlab",
        "cloud": {
          "api": "https://gitlab.com/api/v4",
          "web": "https://gitlab.com"
        },
        "selfHosted": {
          "apiPath": "/api/v4",
          "label": "t:types.gitlabSelf"
        },
        "auth": [
          {
            "method": "pat",
            "scheme": "header",
            "headerName": "PRIVATE-TOKEN",
            "setupUrl": {
              "cloud": "https://gitlab.com/-/user_settings/personal_access_tokens",
              "selfHosted": "{web}/-/user_settings/personal_access_tokens"
            }
          }
        ],
        "extensions": [
          "gitlab.review-requests",
          "gitlab.pipeline-variables",
          "gitlab.approvals"
        ]
      }
    ],
    "recordSchemas": [
      {
        "id": "probe",
        "fields": [
          {
            "key": "account",
            "kind": "text"
          },
          {
            "key": "version",
            "kind": "text"
          },
          {
            "key": "expiresAt",
            "kind": "timestamp"
          },
          {
            "key": "canWrite",
