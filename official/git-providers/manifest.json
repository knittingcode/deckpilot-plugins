        "id": "commit",
        "fields": [
          {
            "key": "sha",
            "kind": "text"
          },
          {
            "key": "title",
            "kind": "text",
            "sensitive": true
          },
          {
            "key": "author",
            "kind": "text",
            "sensitive": true
          },
          {
            "key": "committedAt",
            "kind": "timestamp"
          },
          {
            "key": "webUrl",
            "kind": "url"
          }
        ]
      },
      {
        "id": "change-request",
