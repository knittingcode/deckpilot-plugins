          {
            "key": "number",
            "kind": "integer"
          },
          {
            "key": "title",
            "kind": "text",
            "sensitive": true
          },
          {
            "key": "state",
            "kind": "state"
          },
          {
            "key": "source",
            "kind": "text"
          },
          {
            "key": "target",
            "kind": "text"
          },
          {
            "key": "author",
            "kind": "text",
            "sensitive": true
          },
          {
            "key": "draft",
            "kind": "boolean"
          },
          {
            "key": "webUrl",
            "kind": "url"
          },
          {
            "key": "repository",
            "kind": "text"
          },
          {
            "key": "existing",
            "kind": "boolean"
