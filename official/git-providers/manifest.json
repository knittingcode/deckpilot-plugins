          {
            "key": "id",
            "kind": "text"
          },
          {
            "key": "state",
            "kind": "state"
          },
          {
            "key": "providerStatus",
            "kind": "text"
          },
          {
            "key": "reference",
            "kind": "text"
          },
          {
            "key": "sha",
            "kind": "text"
          },
          {
            "key": "webUrl",
            "kind": "url"
          },
          {
            "key": "createdAt",
            "kind": "timestamp"
          },
          {
            "key": "finishedAt",
            "kind": "timestamp"
          },
          {
            "key": "durationSeconds",
            "kind": "integer"
          }
        ]
      },
      {
        "id": "issue",
        "fields": [
          {
            "key": "number",
            "kind": "integer"
          },
          {
            "key": "title",
            "kind": "text",
            "sensitive": true
          },
          {
            "key": "state",
            "kind": "state"
          },
          {
            "key": "author",
            "kind": "text",
            "sensitive": true
          },
          {
            "key": "webUrl",
            "kind": "url"
          },
          {
            "key": "updatedAt",
            "kind": "timestamp"
          }
        ]
      }
    ],
